local ScreenGui = Instance.new('ScreenGui')
ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global

local Library = {}

function Library:CreateWindow(Config)
    local Window = {}
    
    -- КАРТИНКА-ФОН (самая первая, ZIndex = 0)
    local BG = Instance.new('ImageLabel')
    BG.Image = "rbxassetid://87362885060054"
    BG.BackgroundTransparency = 1
    BG.Size = UDim2.new(1, 0, 1, 0)
    BG.ScaleType = Enum.ScaleType.Crop
    BG.ZIndex = 0
    BG.Parent = ScreenGui
    
    -- ЧЁРНАЯ РАМКА (видна только обводка)
    local Outer = Instance.new('Frame')
    Outer.BackgroundColor3 = Color3.new(0, 0, 0)
    Outer.BorderSizePixel = 0
    Outer.Size = UDim2.fromOffset(550, 600)
    Outer.Position = UDim2.fromScale(0.5, 0.5)
    Outer.AnchorPoint = Vector2.new(0.5, 0.5)
    Outer.ZIndex = 1
    Outer.Parent = ScreenGui
    
    -- Синхронизация картинки с окном
    local function Sync()
        BG.Position = UDim2.fromOffset(Outer.AbsolutePosition.X, Outer.AbsolutePosition.Y)
        BG.Size = UDim2.fromOffset(Outer.AbsoluteSize.X, Outer.AbsoluteSize.Y)
    end
    Outer:GetPropertyChangedSignal('AbsolutePosition'):Connect(Sync)
    Outer:GetPropertyChangedSignal('AbsoluteSize'):Connect(Sync)
    task.defer(Sync)
    
    -- ВНУТРЕННЯЯ РАМКА (прозрачная, только синяя обводка)
    local Inner = Instance.new('Frame')
    Inner.BackgroundColor3 = Color3.new(0, 0, 0)
    Inner.BackgroundTransparency = 1  -- ПОЛНОСТЬЮ ПРОЗРАЧНЫЙ
    Inner.BorderColor3 = Color3.fromRGB(0, 85, 255)
    Inner.BorderMode = Enum.BorderMode.Inset
    Inner.Size = UDim2.new(1, -2, 1, -2)
    Inner.Position = UDim2.new(0, 1, 0, 1)
    Inner.ZIndex = 1
    Inner.Parent = Outer
    
    -- Заголовок
    local Title = Instance.new('TextLabel')
    Title.BackgroundTransparency = 1
    Title.Text = Config.Title or 'Window'
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.TextSize = 16
    Title.Size = UDim2.new(1, 0, 0, 25)
    Title.Position = UDim2.new(0, 7, 0, 0)
    Title.ZIndex = 2
    Title.Parent = Inner
    
    -- Область для табов
    local TabArea = Instance.new('Frame')
    TabArea.BackgroundTransparency = 1
    TabArea.Size = UDim2.new(1, -16, 0, 25)
    TabArea.Position = UDim2.new(0, 8, 0, 30)
    TabArea.ZIndex = 2
    TabArea.Parent = Inner
    
    local TabLayout = Instance.new('UIListLayout')
    TabLayout.FillDirection = Enum.FillDirection.Horizontal
    TabLayout.Padding = UDim.new(0, 5)
    TabLayout.Parent = TabArea
    
    -- Область контента (ПРОЗРАЧНАЯ, никаких фонов!)
    local ContentArea = Instance.new('Frame')
    ContentArea.BackgroundTransparency = 1  -- ПОЛНОСТЬЮ ПРОЗРАЧНЫЙ
    ContentArea.BorderColor3 = Color3.new(0, 0, 0)
    ContentArea.Size = UDim2.new(1, -16, 1, -60)
    ContentArea.Position = UDim2.new(0, 8, 0, 55)
    ContentArea.ZIndex = 2
    ContentArea.Parent = Inner
    
    Window.Holder = Outer
    Window.Content = ContentArea
    Window.TabArea = TabArea
    Window.TabLayout = TabLayout
    
    function Window:AddTab(Name)
        local Tab = {}
        
        -- Кнопка таба (чёрная)
        local TabButton = Instance.new('Frame')
        TabButton.BackgroundColor3 = Color3.new(0, 0, 0)
        TabButton.BorderColor3 = Color3.fromRGB(50, 50, 50)
        TabButton.Size = UDim2.new(0, 100, 1, 0)
        TabButton.ZIndex = 2
        TabButton.Parent = TabArea
        
        local TabLabel = Instance.new('TextLabel')
        TabLabel.BackgroundTransparency = 1
        TabLabel.Text = Name
        TabLabel.TextColor3 = Color3.new(1, 1, 1)
        TabLabel.TextSize = 14
        TabLabel.Size = UDim2.new(1, 0, 1, 0)
        TabLabel.ZIndex = 3
        TabLabel.Parent = TabButton
        
        -- Контент таба (ПРОЗРАЧНЫЙ)
        local TabContent = Instance.new('Frame')
        TabContent.BackgroundTransparency = 1
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.Visible = false
        TabContent.ZIndex = 2
        TabContent.Parent = ContentArea
        
        -- Левая сторона (ПРОЗРАЧНАЯ)
        local LeftSide = Instance.new('ScrollingFrame')
        LeftSide.BackgroundTransparency = 1
        LeftSide.BorderSizePixel = 0
        LeftSide.Size = UDim2.new(0.5, -5, 1, 0)
        LeftSide.Position = UDim2.new(0, 0, 0, 0)
        LeftSide.ScrollBarThickness = 0
        LeftSide.ZIndex = 2
        LeftSide.Parent = TabContent
        
        local LeftLayout = Instance.new('UIListLayout')
        LeftLayout.Padding = UDim.new(0, 10)
        LeftLayout.FillDirection = Enum.FillDirection.Vertical
        LeftLayout.Parent = LeftSide
        
        -- Правая сторона (ПРОЗРАЧНАЯ)
        local RightSide = Instance.new('ScrollingFrame')
        RightSide.BackgroundTransparency = 1
        RightSide.BorderSizePixel = 0
        RightSide.Size = UDim2.new(0.5, -5, 1, 0)
        RightSide.Position = UDim2.new(0.5, 5, 0, 0)
        RightSide.ScrollBarThickness = 0
        RightSide.ZIndex = 2
        RightSide.Parent = TabContent
        
        local RightLayout = Instance.new('UIListLayout')
        RightLayout.Padding = UDim.new(0, 10)
        RightLayout.FillDirection = Enum.FillDirection.Vertical
        RightLayout.Parent = RightSide
        
        LeftSide:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
            LeftSide.CanvasSize = UDim2.fromOffset(0, LeftLayout.AbsoluteContentSize.Y)
        end)
        
        RightSide:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
            RightSide.CanvasSize = UDim2.fromOffset(0, RightLayout.AbsoluteContentSize.Y)
        end)
        
        function Tab:Show()
            TabContent.Visible = true
            TabButton.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
        end
        
        function Tab:Hide()
            TabContent.Visible = false
            TabButton.BackgroundColor3 = Color3.new(0, 0, 0)
        end
        
        function Tab:AddLeftGroupbox(Name)
            local Groupbox = {}
            
            -- Groupbox (ПРОЗРАЧНЫЙ, только заголовок)
            local BoxOuter = Instance.new('Frame')
            BoxOuter.BackgroundTransparency = 1
            BoxOuter.BorderSizePixel = 0
            BoxOuter.Size = UDim2.new(1, 0, 0, 100)
            BoxOuter.ZIndex = 2
            BoxOuter.Parent = LeftSide
            
            local BoxLabel = Instance.new('TextLabel')
            BoxLabel.BackgroundTransparency = 1
            BoxLabel.Text = Name
            BoxLabel.TextColor3 = Color3.new(1, 1, 1)
            BoxLabel.TextSize = 14
            BoxLabel.Size = UDim2.new(1, 0, 0, 20)
            BoxLabel.Position = UDim2.new(0, 0, 0, 0)
            BoxLabel.TextXAlignment = Enum.TextXAlignment.Left
            BoxLabel.ZIndex = 3
            BoxLabel.Parent = BoxOuter
            
            local BoxContainer = Instance.new('Frame')
            BoxContainer.BackgroundTransparency = 1
            BoxContainer.Size = UDim2.new(1, 0, 1, -20)
            BoxContainer.Position = UDim2.new(0, 0, 0, 20)
            BoxContainer.ZIndex = 2
            BoxContainer.Parent = BoxOuter
            
            local BoxLayout = Instance.new('UIListLayout')
            BoxLayout.Padding = UDim.new(0, 5)
            BoxLayout.FillDirection = Enum.FillDirection.Vertical
            BoxLayout.Parent = BoxContainer
            
            function Groupbox:AddButton(Text, Callback)
                local Button = Instance.new('Frame')
                Button.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
                Button.BorderColor3 = Color3.fromRGB(50, 50, 50)
                Button.Size = UDim2.new(1, 0, 0, 25)
                Button.ZIndex = 2
                Button.Parent = BoxContainer
                
                local ButtonLabel = Instance.new('TextLabel')
                ButtonLabel.BackgroundTransparency = 1
                ButtonLabel.Text = Text
                ButtonLabel.TextColor3 = Color3.new(1, 1, 1)
                ButtonLabel.TextSize = 14
                ButtonLabel.Size = UDim2.new(1, 0, 1, 0)
                ButtonLabel.ZIndex = 3
                ButtonLabel.Parent = Button
                
                Button.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Callback()
                    end
                end)
                
                BoxOuter.Size = UDim2.new(1, 0, 0, BoxLayout.AbsoluteContentSize.Y + 20)
            end
            
            function Groupbox:AddToggle(Text, Info)
                local Toggle = {Value = Info.Default or false}
                
                local ToggleFrame = Instance.new('Frame')
                ToggleFrame.BackgroundTransparency = 1
                ToggleFrame.Size = UDim2.new(1, 0, 0, 20)
                ToggleFrame.ZIndex = 2
                ToggleFrame.Parent = BoxContainer
                
                local ToggleBox = Instance.new('Frame')
                ToggleBox.BackgroundColor3 = Toggle.Value and Color3.fromRGB(0, 85, 255) or Color3.new(0.2, 0.2, 0.2)
                ToggleBox.BorderColor3 = Color3.fromRGB(50, 50, 50)
                ToggleBox.Size = UDim2.new(0, 15, 0, 15)
                ToggleBox.ZIndex = 3
                ToggleBox.Parent = ToggleFrame
                
                local ToggleLabel = Instance.new('TextLabel')
                ToggleLabel.BackgroundTransparency = 1
                ToggleLabel.Text = Text
                ToggleLabel.TextColor3 = Color3.new(1, 1, 1)
                ToggleLabel.TextSize = 14
                ToggleLabel.Size = UDim2.new(1, -20, 1, 0)
                ToggleLabel.Position = UDim2.new(0, 20, 0, 0)
                ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
                ToggleLabel.ZIndex = 3
                ToggleLabel.Parent = ToggleFrame
                
                ToggleFrame.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Toggle.Value = not Toggle.Value
                        ToggleBox.BackgroundColor3 = Toggle.Value and Color3.fromRGB(0, 85, 255) or Color3.new(0.2, 0.2, 0.2)
                        if Info.Callback then Info.Callback(Toggle.Value) end
                    end
                end)
                
                BoxOuter.Size = UDim2.new(1, 0, 0, BoxLayout.AbsoluteContentSize.Y + 20)
                return Toggle
            end
            
            function Groupbox:AddSlider(Text, Info)
                local Slider = {Value = Info.Default or 0}
                
                local SliderFrame = Instance.new('Frame')
                SliderFrame.BackgroundTransparency = 1
                SliderFrame.Size = UDim2.new(1, 0, 0, 35)
                SliderFrame.ZIndex = 2
                SliderFrame.Parent = BoxContainer
                
                local SliderLabel = Instance.new('TextLabel')
                SliderLabel.BackgroundTransparency = 1
                SliderLabel.Text = Text .. ': ' .. Slider.Value
                SliderLabel.TextColor3 = Color3.new(1, 1, 1)
                SliderLabel.TextSize = 14
                SliderLabel.Size = UDim2.new(1, 0, 0, 15)
                SliderLabel.ZIndex = 3
                SliderLabel.Parent = SliderFrame
                
                local SliderBar = Instance.new('Frame')
                SliderBar.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
                SliderBar.BorderColor3 = Color3.fromRGB(50, 50, 50)
                SliderBar.Position = UDim2.new(0, 0, 0, 18)
                SliderBar.Size = UDim2.new(1, 0, 0, 12)
                SliderBar.ZIndex = 3
                SliderBar.Parent = SliderFrame
                
                local SliderFill = Instance.new('Frame')
                SliderFill.BackgroundColor3 = Color3.fromRGB(0, 85, 255)
                SliderFill.Size = UDim2.new((Slider.Value - Info.Min) / (Info.Max - Info.Min), 0, 1, 0)
                SliderFill.ZIndex = 4
                SliderFill.Parent = SliderBar
                
                SliderBar.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        local function Update(Input)
                            local Percent = math.clamp((Input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                            Slider.Value = Info.Min + (Info.Max - Info.Min) * Percent
                            SliderFill.Size = UDim2.new(Percent, 0, 1, 0)
                            SliderLabel.Text = Text .. ': ' .. math.floor(Slider.Value)
                            if Info.Callback then Info.Callback(Slider.Value) end
                        end
                        
                        Update(game:GetService("UserInputService"):GetMouseLocation())
                        
                        local Connection
                        Connection = game:GetService("UserInputService").InputChanged:Connect(function(Input)
                            if Input.UserInputType == Enum.UserInputType.MouseMovement then
                                Update(Input.Position)
                            end
                        end)
                        
                        game:GetService("UserInputService").InputEnded:Connect(function(Input)
                            if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                                Connection:Disconnect()
                            end
                        end)
                    end
                end)
                
                BoxOuter.Size = UDim2.new(1, 0, 0, BoxLayout.AbsoluteContentSize.Y + 20)
                return Slider
            end
            
            LeftLayout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
                LeftSide.CanvasSize = UDim2.fromOffset(0, LeftLayout.AbsoluteContentSize.Y)
            end)
            
            return Groupbox
        end
        
        function Tab:AddRightGroupbox(Name)
            return Tab:AddLeftGroupbox(Name)
        end
        
        TabButton.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                Tab:Show()
            end
        end)
        
        return Tab
    end
    
    -- Показ окна
    Outer.Visible = true
    
    return Window
end

function Library:Notify(Text, Time)
    local NotifyOuter = Instance.new('Frame')
    NotifyOuter.BackgroundColor3 = Color3.new(0, 0, 0)
    NotifyOuter.BorderColor3 = Color3.fromRGB(50, 50, 50)
    NotifyOuter.Size = UDim2.new(0, 200, 0, 40)
    NotifyOuter.Position = UDim2.new(0, 100, 0, 100)
    NotifyOuter.ZIndex = 100
    NotifyOuter.Parent = ScreenGui
    
    local NotifyLabel = Instance.new('TextLabel')
    NotifyLabel.BackgroundTransparency = 1
    NotifyLabel.Text = Text
    NotifyLabel.TextColor3 = Color3.new(1, 1, 1)
    NotifyLabel.TextSize = 14
    NotifyLabel.Size = UDim2.new(1, 0, 1, 0)
    NotifyLabel.ZIndex = 101
    NotifyLabel.Parent = NotifyOuter
    
    task.delay(Time or 3, function()
        NotifyOuter:Destroy()
    end)
end

getgenv().Library = Library
return Library
