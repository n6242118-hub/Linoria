function Library:SafeCallback(f, ...) if not f then return end; if not Library.NotifyOnError then return f(...) end; local s, e = pcall(f, ...); if not s then local _, i = e:find(":%d+: "); return Library:Notify(i and e:sub(i+1) or e, 3) end end
function Library:AttemptSave() if Library.SaveManager then Library.SaveManager:Save() end end
function Library:Create(Class, Properties) local I = type(Class)=='string' and Instance.new(Class) or Class; for P, V in next, Properties do I[P] = V end; return I end
function Library:ApplyTextStroke(I) I.TextStrokeTransparency = 1; Library:Create('UIStroke', {Color=Color3.new(0,0,0), Thickness=1, LineJoinMode=Enum.LineJoinMode.Miter, Parent=I}) end
